# SiteIntel Pulse — Environment Configuration Baseline

# Application Host and Port
PORT=3000
# For native Linux deployments behind Nginx, bind strictly to loopback 127.0.0.1.
# For container deployments, HOST=0.0.0.0 allows container port publishing while host binds 127.0.0.1.
HOST=127.0.0.1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment Mode (production / staging / development / test)
NODE_ENV=production

# Staging Demonstration Seed Guard
# When set to true in staging/development, enables controlled seed accounts for demoing.
# NOTE: The application strictly prevents seeding if NODE_ENV=production, regardless of this setting.
ALLOW_STAGING_SEEDS=false

# Crawler & Scanning Budgets (Safe conservative bounds)
CRAWLER_DEFAULT_PAGE_BUDGET=50
CRAWLER_HARD_PAGE_BUDGET=100
CRAWLER_DEPTH_BUDGET=3
CRAWLER_CONCURRENCY=3
CRAWLER_REQUEST_TIMEOUT_MS=10000
CRAWLER_MAX_DECOMPRESSED_PAGE_BYTES=2097152
CRAWLER_MAX_TOTAL_SCAN_BYTES=52428800
CRAWLER_USER_AGENT=SiteIntelPulse-Bot/1.0 (+https://siteintel-pulse.local/bot-policy)

# Optional External Provider Keys (Server-side only — never exposed to client)
# Google PageSpeed Insights API Key (Optional: lab & CWV metrics)
PAGESPEED_API_KEY=

# Persistence (SQLite Durable Adapter with WAL & ACID transactions)
# Path to SQLite database file on local disk or mounted persistent volume:
# - Local development default: ./data/siteintel.db
# - Native Linux VPS deployment: /var/lib/siteintel/data/siteintel.db
# - Docker container staging volume: /app/data/siteintel.db
DATABASE_PATH=./data/siteintel.db

# Authentication & Session Security (MANDATORY in production/staging)
# High-entropy 64-character hexadecimal string used for session cookie HMAC signing.
# Generate on your deployment host using: openssl rand -hex 32
# NOTE: The application will abort startup in production if this variable is missing,
# not 64 hex characters, or matches a known default placeholder or test fixture.
SESSION_SECRET=

# Tenant Rate Limiting & Abuse Prevention Controls
MAX_CONCURRENT_SCANS_PER_TENANT=2
MAX_HOURLY_SCANS_PER_TENANT=20
RATE_LIMIT_ENABLED=true

# Optional External Persistence (PostgreSQL / Supabase)
# If omitted, application uses the durable SQLite engine configured above
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Durable Queue (BullMQ / Redis)
# If omitted, in-process queue handles background jobs gracefully
REDIS_URL=

# Optional S3-compatible Report Artifact Storage
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
