# =================================================================
# SiteIntel Pulse — Hostinger VPS Production Environment Template
# =================================================================
# INSTRUCTIONS:
# 1. Copy this file to /etc/siteintel-pulse.env on your Hostinger VPS:
#      sudo cp .env.production.template /etc/siteintel-pulse.env
#      sudo chmod 600 /etc/siteintel-pulse.env
#      sudo chown siteintel:siteintel /etc/siteintel-pulse.env
# 2. Generate cryptographically strong secrets using openssl:
#      SESSION_SECRET: openssl rand -hex 32
#      PROVIDER_ENCRYPTION_KEY: openssl rand -hex 32
# 3. Fill in your domain name (e.g., https://audit.yourdomain.com).
# 4. NEVER commit your populated /etc/siteintel-pulse.env to Git!
# =================================================================

# --- Core Runtime ---
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
NEXT_PUBLIC_APP_URL=https://audit.yourdomain.com

# --- Persistent SQLite Database Path ---
# Mounted on persistent local SSD/NVMe volume with standard POSIX locking
DATABASE_PATH=/var/lib/siteintel-pulse/data/siteintel.db

# --- Security Secrets (MANDATORY) ---
# High-entropy random secret (>= 32 chars). Application aborts startup if missing or insecure.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# AES-256-GCM 32-byte hexadecimal key (64 hex characters) for OAuth token encryption at rest.
# Generate with: openssl rand -hex 32
PROVIDER_ENCRYPTION_KEY=

# --- Demonstration & Staging Seed Guard ---
# MUST be false in production to prevent seeding demo accounts
ALLOW_STAGING_SEEDS=false

# --- Ingress & Reverse Proxy Header Trust ---
# In Ubuntu 24.04 Nginx reverse proxy setup, Nginx passes authentic client IP via X-Real-IP
TRUSTED_IP_HEADER=x-real-ip

# --- Scanner Budgets & Guardrails ---
CRAWLER_DEFAULT_PAGE_BUDGET=50
CRAWLER_HARD_PAGE_BUDGET=100
CRAWLER_DEPTH_BUDGET=3
CRAWLER_CONCURRENCY=3
CRAWLER_REQUEST_TIMEOUT_MS=10000
CRAWLER_MAX_DECOMPRESSED_PAGE_BYTES=2097152
CRAWLER_MAX_TOTAL_SCAN_BYTES=52428800
CRAWLER_USER_AGENT=SiteIntelPulse-Bot/1.0 (+https://audit.yourdomain.com/bot-policy)

# --- Rate Limiting Controls ---
RATE_LIMIT_ENABLED=true
MAX_CONCURRENT_SCANS_PER_TENANT=2
MAX_HOURLY_SCANS_PER_TENANT=20

# --- Provider Integrations (OAuth & External APIs) ---
# Fill with real credentials once provisioned in provider developer consoles.
# Leave blank or unconfigured to operate in unintegrated mode with truthful reporting.

# Google Analytics 4
GA4_CLIENT_ID=
GA4_CLIENT_SECRET=

# Google Search Console
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=

# Google Ads (API v26)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v26

# Shopify Commerce (GraphQL Admin API)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-10

# HubSpot CRM
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# SERP & Link Intelligence API
SERP_API_KEY=

# PageSpeed Insights API Key (Optional)
PAGESPEED_API_KEY=
